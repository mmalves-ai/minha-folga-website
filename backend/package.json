{
  "name": "minhafolga-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API Node.js + Express da Minha Folga (cadastro, atendimento, preferências, administração e integrações).",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node dist/cli/migrate.js",
    "migrate:dev": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "admin:create": "node dist/cli/admin-create.js",
    "admin:create:dev": "tsx --env-file-if-exists=.env src/cli/admin-create.ts",
    "export:public-config": "node dist/cli/export-public-config.js",
    "retention:review": "node dist/cli/retention-review.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "push:keys": "node dist/cli/push-keys.js",
    "push:keys:dev": "tsx src/cli/push-keys.ts"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "web-push": "3.6.7",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "@types/web-push": "3.6.4",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
