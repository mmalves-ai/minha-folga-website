# Backend Minha Folga — exemplo SEM credenciais reais. Copie para um arquivo privado fora do
# document root (produção: <MINHAFOLGA_APP_ROOT>/config/.env.production) e informe o caminho em
# MF_ENV_FILE. Quando MF_ENV_FILE é usado, ele é a ÚNICA fonte de configuração do processo.
# Valores entre < > são marcadores de documentação: a validação recusa marcadores fora do desenvolvimento.

NODE_ENV=production
# Homologação/produção: somente loopback (127.0.0.1 ou ::1); o servidor web faz o proxy.
HOST=127.0.0.1
PORT=<porta exclusiva validada ou fornecida pela hospedagem>
# Proxy reverso na mesma máquina: loopback. Ajuste à topologia real (lista de IPs/CIDRs confiáveis).
TRUST_PROXY=loopback
LOG_LEVEL=info

# Fase financeira. PRE_LAUNCH bloqueia no servidor todas as rotas de crédito.
CREDIT_PHASE=PRE_LAUNCH
CREDIT_OPERATIONS_ENABLED=false

PUBLIC_SITE_URL=https://www.minhafolga.com.br
# Origens aceitas em chamadas do navegador (padrão: PUBLIC_SITE_URL).
# ALLOWED_ORIGINS=https://www.minhafolga.com.br

# Identidade empresarial REAL (obrigatória em homologação/produção; aparece no rodapé e nos avisos legais).
LEGAL_ENTITY_NAME=<razão social real>
LEGAL_ENTITY_TRADE_NAME=Minha Folga
LEGAL_ENTITY_CNPJ=<CNPJ real>
LEGAL_ENTITY_ADDRESS=<endereço real>
PRIVACY_CONTACT=<e-mail real do canal de privacidade>
PRIVACY_OFFICER_NAME=<nome do encarregado de dados>
SUPPORT_CONTACT=<e-mail real de atendimento>
# SUPPORT_PHONE=+55DDNNNNNNNNN
SUPPORT_HOURS=<horário real de atendimento humano, ex.: segunda a sexta, 9h às 18h (horário de Brasília)>
# Exibido somente se corresponder à capacidade real da equipe.
# SUPPORT_RESPONSE_TIME=<prazo real, ex.: até 2 dias úteis>
HUMAN_SUPPORT_ENABLED=false

# Interruptor do formulário de cadastro do SITE (ataque de robôs). false = fechado; o painel não reabre.
# A Bia e o pedido de saída continuam. O painel (papel admin) também pausa sem reiniciar.
WAITLIST_FORM_ENABLED=true

# Decisão D1 (docs/DECISOES.md): este sistema NÃO envia WhatsApp. Número oficial, Bia, webchat, filas,
# operadores e templates são da plataforma Hal-AI. Variáveis antigas (MESSAGE_PROVIDER, WHATSAPP_CLOUD_*,
# WHATSAPP_TEMPLATE_*, MESSAGE_WEBHOOK_*, DEV_MESSAGE_LOG_FILE, HALAI_BASE_URL, HALAI_API_SECRET) não têm mais
# efeito: a API avisa no log quando ainda aparecem aqui.

# Número oficial do WhatsApp hospedado na Hal-AI (E.164): botão flutuante do site (wa.me). Vazio = sem botão.
WHATSAPP_BUSINESS_NUMBER=

# Bia (Hal-AI) chamando as APIs daqui (/api/agent/*). Credenciais só no servidor, nunca no navegador.
HALAI_ENABLED=false
# Chave que a Hal-AI envia em X-API-Key (obrigatória com HALAI_ENABLED=true; 32+ bytes, distinta dos demais).
# HALAI_INBOUND_API_KEY=<gerada pela equipe e cadastrada na configuração das ferramentas da Hal-AI>
# Opcional: com este segredo, as chamadas também precisam da assinatura v1 (X-MF-Timestamp/X-MF-Signature/X-MF-Request-Id).
# HALAI_WEBHOOK_SECRET=<segredo de assinatura; 32+ bytes, distinto dos demais>

# Saída para a API pública da Hal-AI — PLACEHOLDER (agente ainda não provisionado). Nada é enviado por padrão.
# HALAI_API_BASE_URL=https://api.halai.com.br
# HALAI_API_KEY=<chave hal_… emitida pela Hal-AI; somente servidor; 16+ bytes>
# HALAI_CHANNEL=<identificador do canal WhatsApp da Minha Folga na Hal-AI>
# Template de WhatsApp após um cadastro NOVO pelo site. Só dispara depois das travas anti-robô, uma vez por
# número a cada 30 dias e dentro do teto diário global. Templates são pagos: mantenha false até decidir.
HALAI_SIGNUP_TEMPLATE_ENABLED=false
# HALAI_SIGNUP_TEMPLATE=<nome do template aprovado na Hal-AI>
# HALAI_TEMPLATE_DAILY_CAP=<teto diário global de templates; obrigatório quando o envio está ligado>

# Webchat da Hal-AI (placeholder): canal preferencial do site, carregado só depois do clique. Quando ligado, a
# CSP do servidor web precisa liberar a origem do script.
HALAI_WEBCHAT_ENABLED=false
# HALAI_WEBCHAT_SCRIPT_URL=<https://… do script do widget fornecido pela Hal-AI>
# HALAI_WEBCHAT_WIDGET_ID=<identificador do widget>

# Banco PostgreSQL e usuário EXCLUSIVOS da Minha Folga (menor privilégio).
DATABASE_URL=<postgres://usuario:senha@127.0.0.1:5432/minhafolga>
DATABASE_POOL_MAX=5

# Notificação interna de novas solicitações de atendimento (opcional, assinada).
# SUPPORT_NOTIFY_WEBHOOK_URL=<https://…>
# SUPPORT_NOTIFY_WEBHOOK_SECRET=<segredo de assinatura; 32+ bytes, distinto dos demais>

# Segredos gerados e gerenciados (ver docs/ENVIRONMENT.md para gerar):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONTACT_ENCRYPTION_KEY=<32 bytes em base64; rotação: id:base64,id:base64>
CONTACT_DEDUP_HMAC_KEY=<segredo distinto, 32+ bytes>
# SESSION_SECRET também assina o token anti-robô do formulário (GET /api/form-token).
SESSION_SECRET=<segredo distinto, 32+ bytes>
READINESS_TOKEN=<token da verificação interna de prontidão, 24+ caracteres>

ANALYTICS_ENABLED=false
COOKIE_SECURE=true
# inline: o worker de comunicação roda dentro da API. separate: processo minhafolga-worker.
WORKER_MODE=inline

# Web Push opt-in de visitantes/clientes (independente de crédito, Hal-AI e WhatsApp).
# Gere uma vez com npm run push:keys:dev -- --subject=mailto:contato-real@dominio
# A CLI grava backend/.env.web-push com modo 0600 e não imprime a chave privada.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_DAILY_CAMPAIGN_CAP=3
