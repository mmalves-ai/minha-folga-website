# Frontend — SOMENTE informações públicas. Variáveis VITE_ vão para o bundle do navegador:
# nunca coloque segredos aqui.
VITE_SITE_URL=https://www.minhafolga.com.br
VITE_API_BASE_URL=/api

# Variáveis de build (não entram no bundle; lidas apenas pelo vite.config.ts):
# Caminho do JSON de configuração pública exportado pelo backend (scripts/build.sh gera).
# MF_PUBLIC_CONFIG_FILE=/caminho/para/public-config.json
# 1 = release pública: falha com pendências de identidade, revisão editorial e avisos legais.
# MF_STRICT_RELEASE=0
# 1 = HTML e robots.txt indexáveis; exige configuração pública de produção.
# Homologação/revisão mantém noindex no HTML e Disallow: / no robots.txt.
# MF_INDEXABLE=0
# Destino do proxy /api do servidor de desenvolvimento.
# MF_DEV_API_TARGET=http://127.0.0.1:3170
