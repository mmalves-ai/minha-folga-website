{
  "name": "minhafolga-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Website corporativo da Minha Folga em Vue 3 + Vite + TypeScript, com páginas públicas pré-renderizadas.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "vite-ssg build && node scripts/postbuild.mjs",
    "preview:static": "node scripts/static-server.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@unhead/vue": "2.1.17",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "jsdom": "29.1.1",
    "markdown-it": "15.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vite-ssg": "28.3.0",
    "vitest": "5.0.2",
    "vue-tsc": "3.3.11",
    "yaml": "2.9.1"
  }
}
